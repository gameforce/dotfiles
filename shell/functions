# functions
# colors (gnu)
eval $(dircolors $ZSH_BASE/dircolors/dircolors.ansi-dark)
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# keychain
if command -v keychain >/dev/null 2>&1; then
    eval "$(keychain --eval --agents ssh id_ed25519_github 2>/dev/null)"
else
    echo "keychain is not installed, please install it first"
fi

# neofetch
$HOME/.dotfiles/neofetch/neofetch --disable packages

# tmux new
tn() {
	tmux new -s "$1";
}

# tmux attach
ta() {
	tmux attach -t "$1";
}

# claude: tab title Claude:<path> instead of Claude Code's session topic
claude() {
	print -Pn "\e]2;Claude:%~\a"
	CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1 command claude "$@";
}

# short names for repos outside ~ (shown as ~name in prompts and titles)
[[ -d /mnt/c/Users/darf/git/forever ]] && hash -d forever=/mnt/c/Users/darf/git/forever
