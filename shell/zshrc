# keychain must stay ABOVE the p10k instant prompt block (it asks for the key passphrase at startup).
# Claude Code shells (CLAUDECODE set) never get the admin agent: Claude uses its own read-only key.
if [[ -n "$CLAUDECODE" ]]; then
  unset SSH_AUTH_SOCK SSH_AGENT_PID
else
  eval $(keychain --eval --quiet --agents ssh ~/.ssh/id_ed25519_admin)
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# .zshrc
ZSH_BASE=$HOME/.dotfiles # Base directory for ZSH configuration

source $ZSH_BASE/antigen/antigen.zsh # Load Antigen

source ~/.aliases # Source some extra files
source ~/.functions
source ~/.environment

antigen use oh-my-zsh # Yes, I want to use Oh My ZSH

# Terminal stuff
antigen bundle git
antigen bundle kubectl
antigen bundle zsh-users/zsh-syntax-highlighting
antigen bundle zsh-users/zsh-history-substring-search
antigen bundle zsh-users/zsh-autosuggestions

# Do OS dependant stuff
case `uname` in
  Darwin)
    # Commands for OS X go here
    antigen bundle osx
  ;;
esac

# Set the theme
#antigen theme essembeh
antigen theme romkatv/powerlevel10k

# And lastly, apply the Antigen stuff
antigen apply

# Tab title: host:path at the prompt, host:command while running
ZSH_THEME_TERM_TITLE_IDLE="%m:%~"
ZSH_THEME_TERM_TAB_TITLE_IDLE="%m:%~"

# Only relevant on the one machine with `brew install helm@2`; harmless
# no-op everywhere else.
[[ -d /usr/local/opt/helm@2/bin ]] && export PATH="/usr/local/opt/helm@2/bin:$PATH"

# `antigen bundle kubectl` above already loads this, but re-source it
# defensively in case antigen hasn't populated ~/.antigen yet.
[[ -f $HOME/.antigen/bundles/robbyrussell/oh-my-zsh/plugins/kubectl/kubectl.plugin.zsh ]] && \
  source $HOME/.antigen/bundles/robbyrussell/oh-my-zsh/plugins/kubectl/kubectl.plugin.zsh
#source .dotfiles/powerline/powerline/bindings/zsh/powerline.zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<

# opencode
export PATH=/home/darf/.opencode/bin:$PATH


# Added by Antigravity CLI installer
export PATH="/home/darf/.local/bin:$PATH"

# Claude Code shells (CLAUDECODE set): drop any ssh-agent set above (keychain in ~/.functions loads the GitHub key too).
[[ -n "$CLAUDECODE" ]] && unset SSH_AUTH_SOCK SSH_AGENT_PID
